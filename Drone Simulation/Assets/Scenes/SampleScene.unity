  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"front_cam_link\">\n  <sensor name=\"front_cam_camera_sensor\"
    type=\"camera\">\n    <update_rate>10</update_rate>\n    <camera>\n      <horizontal_fov>1.5707963267948966</horizontal_fov>\n     
    <image>\n        <format>R8G8B8</format>\n        <width>320</width>\n       
    <height>240</height>\n      </image>\n      <clip>\n        <near>0.01</near>\n       
    <far>100</far>\n      </clip>\n    </camera>\n    <plugin filename=\"libgazebo_ros_camera.so\"
    name=\"front_cam_camera_controller\">\n      <cameraName>front_cam</cameraName>\n     
    <imageTopicName>camera/image</imageTopicName>\n      <cameraInfoTopicName>camera/camera_info</cameraInfoTopicName>\n     
    <frameName>front_cam_optical_frame</frameName>\n    </plugin>\n  </sensor>\n</gazebo>"
--- !u!114 &1979816646
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1979816643}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"sonar_link\">\n  <sensor name=\"sonar\" type=\"ray\">\n   
    <always_on>true</always_on>\n    <update_rate>10</update_rate>\n    <pose>0 0
    0 0 0 0</pose>\n    <visualize>false</visualize>\n    <ray>\n      <scan>\n       
    <horizontal>\n          <samples>3</samples>\n          <resolution>1</resolution>\n         
    <min_angle>-0.3490658503988659</min_angle>\n          <max_angle> 0.3490658503988659</max_angle>\n       
    </horizontal>\n        <vertical>\n          <samples>3</samples>\n         
    <resolution>1</resolution>\n          <min_angle>-0.3490658503988659</min_angle>\n         
    <max_angle> 0.3490658503988659</max_angle>\n        </vertical>\n      </scan>\n     
    <range>\n        <min>0.03</min>\n        <max>3.0</max>\n        <resolution>0.01</resolution>\n     
    </range>\n    </ray>\n    <plugin filename=\"libhector_gazebo_ros_sonar.so\"
    name=\"gazebo_ros_sonar_controller\">\n      <gaussianNoise>0.005</gaussianNoise>\n     
    <topicName>sonar_height</topicName>\n      <frameId>sonar_link</frameId>\n   
    </plugin>\n  </sensor>\n</gazebo>"
